PORT=3000
NODE_ENV=production
APP_BASE_URL=https://hotspot.perumnet.com
SESSION_SECRET=ganti-dengan-rahasia-panjang
ADMIN_EMAIL=it@perumnet.id
ADMIN_PASSWORD=ganti-kata-sandi-admin
ADMIN_SESSION_HOURS=3
# mock untuk pengembangan; redirect untuk gateway. WiFiDog terdeteksi otomatis
# dari gw_address, gw_port, dan token yang diteruskan oleh Reyee.
REYEE_AUTH_MODE=mock
REYEE_USERNAME_PARAM=username
REYEE_PASSWORD_PARAM=password
REYEE_POST_URL_PARAM=post_url
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@perumnet.id
SMTP_PASSWORD=ganti-password-mailbox
EMAIL_FROM=no-reply@perumnet.id
EMAIL_REPLY_TO=it@perumnet.id
# Isi jika SMTP_HOST memakai IP/private network, agar sertifikat TLS tetap
# diverifikasi menggunakan nama domain mail server.
SMTP_TLS_SERVERNAME=mail.perumnet.id
